---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { name } from '../data/site';
import { featured, others, type Project } from '../data/projects';
import { linkAttrs } from '../utils/links';

const sections: { id: string; title: string; projects: Project[] }[] = [
  { id: 'featured', title: 'Featured', projects: featured },
  { id: 'others', title: 'Others', projects: others },
];

const displayUrl = (href: string) => href.replace(/^https?:\/\//, '').replace(/\/$/, '');
---
<Base title={`Projects · /${name}/`}>
  <PageHeader title="Projects" />

  <main class="w-full max-w-[38rem] flex-1 space-y-16">
    {sections.map((section) => (
      <section aria-labelledby={section.id}>
        <h2 id={section.id} class="section-heading">{section.title}</h2>
        {section.projects.length > 0 ? (
          <ul class="space-y-8">
            {section.projects.map((project) => (
              <li>
                <h3 class="font-bold">{project.name}</h3>
                <p class="opacity-90">{project.description}</p>
                {project.href && (
                  <a class="tap-target font-link text-sm opacity-60" href={project.href} {...linkAttrs(project.href)}>
                    {displayUrl(project.href)} ↗
                  </a>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-sm italic opacity-60">More coming soon.</p>
        )}
      </section>
    ))}
  </main>
</Base>
