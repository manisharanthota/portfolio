---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { name } from '../data/site';
import { intro, work, skills, solidarity } from '../data/about';
---
<Base title={`About · /${name}/`}>
  <PageHeader title="About" />

  <main class="w-full max-w-[38rem] flex-1 space-y-16">
    <div class="space-y-4 opacity-90">
      {intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <section aria-labelledby="work">
      <h2 id="work" class="section-heading">Work</h2>
      <ol class="space-y-10">
        {work.map((job) => (
          <li>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4">
              <h3 class="font-bold">{job.company}</h3>
              <span class="text-sm opacity-60">{job.dates}</span>
            </div>
            <p class="text-sm italic opacity-80">{job.role} · {job.location}</p>
            <ul class="mt-3 list-disc space-y-1.5 pl-5 opacity-90 marker:text-muted">
              {job.highlights.map((point) => <li>{point}</li>)}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="skills">
      <h2 id="skills" class="section-heading">Skills</h2>
      <dl class="space-y-4">
        {skills.map((group) => (
          <div class="sm:grid sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="text-sm opacity-60 sm:pt-0.5">{group.category}</dt>
            <dd>
              <ul class="skill-list opacity-90">
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <section aria-labelledby="solidarity">
      <h2 id="solidarity" class="section-heading">In Solidarity With</h2>
      <ul class="space-y-2 opacity-90">
        {solidarity.map((cause) => <li>{cause}</li>)}
      </ul>
    </section>
  </main>
</Base>
